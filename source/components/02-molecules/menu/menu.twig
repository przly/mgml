<div data-component="mol-menu" class="menu {{ menu_extra_class }}" data-lenis-prevent>
	<div class="menu__body">
		<nav aria-label="Primary navigation">
			<ul class="menu__list : level-1">
				{% for item in menu.items %}
					<li
						class="menu__item : level-1 {{ item.is_active ? 'is-active' }} {{
						item.sub_menu
							? 'has-submenu'
						}}"
					>
						<div class="menu__item-wrap">
							{% if item.href %}
								<a
									href="{{ item.href }}"
									{{ item.rel ? 'rel="' ~ item.rel ~ '"' }}
									{{ item.target ? 'target="' ~ item.target ~ '"' }}
									class="menu__link : level-1"
								>
									<span class="menu__text : p-none">{{ item.text }}</span>

									{% if item.sub_menu %}
										<span class="p-none">
											{% include '@atoms/icons/icons.twig' with {
												icon_modifier: 'chevron-down'
											} %}
										</span>
									{% endif %}
								</a>
							{% else %}
								<div class="menu__link : level-1">
									<span class="menu__text : p-none">{{ item.text }}</span>

									{% if item.sub_menu %}
										<span class="p-none">
											{% include '@atoms/icons/icons.twig' with {
												icon_modifier: 'chevron-down'
											} %}
										</span>
									{% endif %}
								</div>
							{% endif %}

							{% if item.sub_menu %}
								<button class="menu__arrow" aria-label="open submenu"></button>
							{% endif %}
						</div>

						{% if item.sub_menu %}
							<div class="menu__dropdown">
								<ul class="menu__list : level-2">
									{% for item in item.sub_menu %}
										<li class="menu__item : level-2">
											<div class="container">
												{% if item.href %}
													<a
														href="{{ item.href }}"
														{{ item.rel ? 'rel="' ~ item.rel ~ '"' }}
														{{ item.target ? 'target="' ~ item.target ~ '"' }}
														class="menu__link : level-2 {{
														item.select__color
															? 'has-tag ' ~ item.select__color
														}}"
													>
														<span class="menu__label">{{ item.text }}</span>
													</a>
												{% else %}
													<div class="menu__link : level-2"><span class="menu__label">{{ item.text }}</span></div>
												{% endif %}

												{% if item.image__image %}
													<div class="menu__image : bg-image">
														<img
															src="{{ item.image__image }}"
															alt="{{ item.image_alt }}"
															width="405"
															height="208"
														/>
													</div>
												{% endif %}
											</div>
										</li>
									{% endfor %}
								</ul>

								<div class="menu__overlay"></div>
							</div>
						{% endif %}
					</li>
				{% endfor %}
			</ul>
		</nav>

		{% if language_switch %}
			<div class="menu__footer : d-lg-none">
				{% include '@molecules/language-switch/language-switch.twig' with {
					language_switch: language_switch
				} %}

				{% if trade_button.href %}
					{% include '@atoms/button/button.twig' with {
						href: trade_button.href,
						text: trade_button.text,
						target: trade_button.target,
						rel: trade_button.rel,
						icon: 'bag'
					} %}
				{% endif %}
			</div>
		{% endif %}
	</div>
</div>
